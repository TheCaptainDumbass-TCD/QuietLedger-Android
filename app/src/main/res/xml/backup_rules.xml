<?xml version="1.0" encoding="utf-8"?>
<!--
  The Android 11 and earlier equivalent of data_extraction_rules.xml.

  `allowBackup="false"` already disables backup, and `dataExtractionRules`
  covers Android 12 and above. Android Lint pointed out that neither of those
  addresses API 29 and 30, where `fullBackupContent` is the mechanism. Belt and
  braces: if `allowBackup` is ever flipped on, by us or by a library's manifest
  merge, this still excludes everything on those versions rather than silently
  starting to back up the financial database.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
